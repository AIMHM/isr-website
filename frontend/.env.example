# ISR Website frontend — safe local review defaults
# Copy this file to `.env.local` for ordinary UI/UX review.
# These values do not connect the frontend to the production ISR backend.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_LOCAL_ADMIN_MODE=false
NEXT_PUBLIC_USE_MOCK_DATA=true

# Set NEXT_PUBLIC_USE_MOCK_DATA=false only when intentionally testing a
# configured development backend. Do not paste production secrets here;
# NEXT_PUBLIC_* variables are exposed to the browser by design.
