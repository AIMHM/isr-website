generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id               Int      @id @default(autoincrement())
  name             String
  date             DateTime
  endDate          DateTime?
  imageUrl         String?
  description      String
  ticketUrl        String?
  registrationMode String   @default("unknown")
  category         String?
  venue            String?
  campus           String?
  audience         String?
  price            String?
  accessibility    String?
  status            String   @default("scheduled")
  statusNote        String?
  publicationStatus String   @default("draft")
  contentOwner      String?
  reviewedAt       DateTime?

  @@index([date])
  @@index([status])
  @@index([registrationMode])
  @@index([publicationStatus])
}

model Announcement {
  id                Int      @id @default(autoincrement())
  title             String
  body              String
  pinned            Boolean  @default(false)
  imageUrl          String?
  createdAt         DateTime @default(now())
  priority          String   @default("normal")
  expiresAt         DateTime?
  actionLabel       String?
  actionUrl         String?

  scope             String   @default("general")
  campus            String?
  audience          String?
  publicationStatus String   @default("draft")
  contentOwner      String?
  reviewedAt        DateTime?

  @@index([createdAt])
  @@index([expiresAt])
  @@index([publicationStatus])
  @@index([scope])
  @@index([campus])
}


model Program {
  id               Int      @id @default(autoincrement())
  slug             String   @unique
  name             String
  summary          String
  description      String
  category         String

  campusId         String
  campusLabel      String
  venue            String
  audience         String

  weekday          Int
  startTime        String
  endTime          String
  intervalWeeks    Int      @default(1)

  activeFrom       DateTime
  activeUntil      DateTime

  registrationMode String   @default("none")
  registrationUrl  String?
  price             String?

  status            String   @default("active")
  publicationStatus String   @default("draft")

  imageUrl          String?

  contentOwner      String?
  lastReviewedAt    DateTime?
  reviewDueAt       DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  exceptions ProgramException[]

  @@index([status])
  @@index([publicationStatus])
  @@index([campusId])
  @@index([activeFrom, activeUntil])
}

model ProgramException {
  id        Int      @id @default(autoincrement())
  programId Int

  date      DateTime
  status    String
  startTime String?
  endTime   String?
  venue     String?
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, date])
  @@index([date])
}
model PrayerSpace {
  id                Int      @id @default(autoincrement())
  slug              String   @unique
  name              String
  campus            String
  summary           String
  building          String
  room              String
  accessHours       String
  wudu              String
  brothers          String
  sisters           String
  accessibility     String

  publicationStatus String   @default("draft")
  verificationStatus String  @default("needs-review")

  contentOwner      String?
  sourceLabel       String?
  reviewedAt        DateTime?
  reviewDueAt       DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([campus])
  @@index([publicationStatus])
  @@index([verificationStatus])
  @@index([reviewDueAt])
}

model JumuahService {
  id                 Int      @id @default(autoincrement())
  slug               String   @unique
  campus             String
  venue              String
  brothers           String
  sisters            String
  notes              String

  timeRule           String
  standardTime       String?
  daylightSavingTime String?

  publicationStatus  String   @default("draft")
  verificationStatus String   @default("needs-review")

  contentOwner       String?
  sourceLabel        String?
  reviewedAt         DateTime?
  reviewDueAt        DateTime?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([campus])
  @@index([publicationStatus])
  @@index([verificationStatus])
  @@index([reviewDueAt])
}
