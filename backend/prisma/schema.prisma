generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id            Int      @id @default(autoincrement())
  name          String
  date          DateTime
  endDate       DateTime?
  imageUrl      String
  description   String
  ticketUrl     String?
  venue         String?
  campus        String?
  audience      String?
  price         String?
  accessibility String?
  status        String   @default("scheduled")
  statusNote    String?

  @@index([date])
  @@index([status])
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  body        String
  pinned      Boolean  @default(false)
  imageUrl    String?
  createdAt   DateTime @default(now())
  priority    String   @default("normal")
  expiresAt   DateTime?
  actionLabel String?
  actionUrl   String?

  @@index([createdAt])
  @@index([expiresAt])
}


model Program {
  id               Int      @id @default(autoincrement())
  slug             String   @unique
  name             String
  summary          String
  description      String
  category         String

  campusId         String
  campusLabel      String
  venue            String
  audience         String

  weekday          Int
  startTime        String
  endTime          String
  intervalWeeks    Int      @default(1)

  activeFrom       DateTime
  activeUntil      DateTime

  registrationMode String   @default("none")
  registrationUrl  String?
  price             String?

  status            String   @default("active")
  publicationStatus String   @default("published")

  imageUrl          String?

  contentOwner      String?
  lastReviewedAt    DateTime?
  reviewDueAt       DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  exceptions ProgramException[]

  @@index([status])
  @@index([publicationStatus])
  @@index([campusId])
  @@index([activeFrom, activeUntil])
}

model ProgramException {
  id        Int      @id @default(autoincrement())
  programId Int

  date      DateTime
  status    String
  startTime String?
  endTime   String?
  venue     String?
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, date])
  @@index([date])
}
