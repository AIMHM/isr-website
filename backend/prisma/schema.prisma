generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id            Int      @id @default(autoincrement())
  name          String
  date          DateTime
  endDate       DateTime?
  imageUrl      String
  description   String
  ticketUrl     String?
  venue         String?
  campus        String?
  audience      String?
  price         String?
  accessibility String?
  status        String   @default("scheduled")
  statusNote    String?

  @@index([date])
  @@index([status])
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  body        String
  pinned      Boolean  @default(false)
  imageUrl    String?
  createdAt   DateTime @default(now())
  priority    String   @default("normal")
  expiresAt   DateTime?
  actionLabel String?
  actionUrl   String?

  @@index([createdAt])
  @@index([expiresAt])
}
