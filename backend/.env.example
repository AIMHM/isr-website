# ISR Website backend — DEVELOPMENT TEMPLATE ONLY
# Copy to `.env` only when intentionally running the backend locally.
# Use development/test service credentials and a NON-PRODUCTION database.
# Never commit real credentials.

PORT=4000
NODE_ENV=development

# Development database only. Do not paste the production DATABASE_URL here.
DATABASE_URL=postgresql://isr_dev:isr_dev@localhost:5432/isr_dev

# Development/test Supabase project only if backend features are being tested.
SUPABASE_URL=https://your-development-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-development-key
SUPABASE_ANON_KEY=replace-with-development-key
SUPABASE_SECRET_KEY=replace-with-development-secret

CORS_ALLOWED_ORIGINS=http://localhost:3000

WEATHER_API_KEY=replace-with-development-key
RESEND_API_KEY=replace-with-development-key
RESEND_FROM_ADDRESS=dev@example.com
